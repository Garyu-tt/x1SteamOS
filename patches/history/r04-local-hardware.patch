 	DRM_FORMAT_MOD_NVIDIA_16BX2_BLOCK(0),
@@ -3038,8 +3056,8 @@ static const struct tegra_dc_soc_info tegra210_dc_soc_info = {
 	.has_powergate = true,
 	.coupled_pm = false,
